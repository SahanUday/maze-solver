# ---- PlatformIO build output --------------------------------------
# Rebuilt from source every time; never belongs in git.
.pio/
.pioenvs/
.piolibdeps/

# ---- Editor / tooling ---------------------------------------------
.vscode/
compile_commands.json
.clangd/
.claude/

# ---- Python analysis toolkit ---------------------------------------
__pycache__/
*.pyc
.venv/
venv/

# ---- KiCad local files ----------------------------------------------
# Per-user editor state, locks, caches and backups; the design is the
# .kicad_pro / .kicad_sch / .kicad_pcb files and fab/.
*.kicad_prl
*.lck
fp-info-cache
*-backups/
.history/
_autosave-*
*.kicad_sch-bak
*.kicad_pcb-bak

# ---- OS noise -------------------------------------------------------
.DS_Store
Thumbs.db

# ---- Simulator binary ----------------------------------------------
# The prebuilt mms AppImage (54 MB, over the 1 MB large-file hook); see sim/README.md.
*.AppImage
